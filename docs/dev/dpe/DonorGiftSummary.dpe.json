		"_archive_note": "Full DPE payload retrieved from a Fundraising Cloud org. Joins, filters, appends, transforms, aggregates, and writebacks are extensive (~90 nodes total); this repo captures the datasources and the recurring-relevant excerpts in the sibling .md walkthrough. The complete JSON — including every Join_*, Filter_*, Calculate_*, Merge_*, and Insert/Update/Delete writeback node — was pasted into the conversation on 2026-08-15 and is the authoritative reference. Re-retrieve fresh from any org with: sf project retrieve start --metadata 'DataProcessingEngineDefinition:DonorGiftSummary'",
		"key_filters_for_recurring_metrics": {
			"Filter_on_isPaid_Gift_Transaction": {
				"sourceName": "Gift_Transaction",
				"criteria": "IsPaid Equals true"
			},
			"Filter_on_isRecurring": {
				"sourceName": "Join_isPaid_Gift_Transaction_and_Gift_Commitment",
				"criteria": "ScheduleType Equals 'Recurring' (STRICT equality — no IN, no wildcard)"
			},
			"Filter_on_isNotClosed": {
				"sourceName": "Filter_on_isRecurring",
				"criteria": "Status NotEquals 'Closed'"
			},
			"Written_Formal_Commitments": {
				"sourceName": "Gift_Commitments (appended stream, individual + household-swapped)",
				"criteria": "FormalCommitmentType Equals 'Written' — NO ScheduleType gate; Custom-schedule Written pledges DO enter BookedPledges"
			},
			"Filter_Written_Formal_Transactions": {
				"sourceName": "Join_isPaid_Gift_Transaction_and_Gift_Commitment",
				"criteria": "FormalCommitmentType Equals 'Written' AND GiftCommitmentId IsNotNull"
			}
		},
		"key_aggregates_for_recurring_metrics": {
			"Calculate_Recurring_Installments": {
				"sourceName": "Filter_on_isRecurring",
				"groupBy": ["DonorId"],
				"outputs": {
					"Sum(CurrentAmount)": "Total_Paid_RcrInstl_Amt → TotalPaidRcrInstlAmt",
					"Count(Id)":           "Total_Paid_Rcr_Installments → TotalPaidRcrInstallments",
					"Min(TransactionDate)":"First_Recurring_Start_Date → FirstRecurringStartDate",
					"Max(TransactionDate)":"Last_Recurring_Payment_Date → LastRecurringPaymentDate"
				}
			},
			"Calculate_Current_Recurring": {
				"sourceName": "Filter_on_isNotClosed",
				"groupBy": ["DonorId"],
				"outputs": {
					"Min(TransactionDate)": "Current_Recurring_Start_Date → CurrentRecurringStartDate (EARLIEST PAID TRANSACTION DATE on active Recurring pledges — NOT commitment StartDate)"
				}
			},
			"Group_Written_Commitments_by_Donor": {
				"sourceName": "Written_Formal_Commitments",
				"groupBy": ["DonorId"],
				"outputs": {
					"Sum(ExpectedTotalCmtAmount)": "Booked_Pledges → BookedPledges (schedule-type-agnostic)"
				}
			},
			"Calculate_Total_Written_Formal_Transaction_Amount": {
				"sourceName": "Filter_Written_Formal_Transactions",
				"groupBy": ["DonorId"],
				"outputs": {
					"Sum(CurrentAmount)": "Total_Written_Formal_Transaction_Amount (subtracted from Booked_Pledges + Total_Gift_Amount to form Total_Bookable_Revenue)"
				}
			}
		},
		"parameters": [
			{"name": "CURRENT_CALENDAR_YEAR", "label": "CURRENT_CALENDAR_YEAR", "dataType": "Date"},
