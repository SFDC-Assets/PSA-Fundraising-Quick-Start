<?xml version="1.0" encoding="UTF-8"?>
<ListView xmlns="urn:metadata.tooling.soap.sforce.com">
    <fullName>FQS_Recurring_Outreach</fullName>
    <filterScope>Everything</filterScope>
    <filters>
        <field>RecurringDonorCount</field>
        <operation>greaterThan</operation>
        <value>0</value>
    </filters>
    <label>Recurring Outreach</label>
    <columns>Name</columns>
    <columns>Campaign</columns>
    <columns>OutreachSourceCode</columns>
    <columns>RecurringDonorCount</columns>
    <columns>GiftCount</columns>
    <columns>DonorCount</columns>
</ListView>
