<?xml version="1.0" encoding="UTF-8"?>
<ListView xmlns="urn:metadata.tooling.soap.sforce.com">
    <fullName>FQS_Lapsed_Recurring</fullName>
    <columns>Name</columns>
    <columns>Donor</columns>
    <columns>Status</columns>
    <columns>LastPaidTransactionDate</columns>
    <columns>NextTransactionDate</columns>
    <columns>ExpectedTotalCmtAmount</columns>
    <filterScope>Everything</filterScope>
    <filters>
        <field>FQS_Gift_Commitment_Category__c</field>
        <operation>equals</operation>
        <value>Recurring Gift</value>
    </filters>
    <filters>
        <field>LastPaidTransactionDate</field>
        <operation>lessThan</operation>
        <value>LAST_N_DAYS:60</value>
    </filters>
    <label>FQS Lapsed Recurring — No Gift 60d</label>
</ListView>
