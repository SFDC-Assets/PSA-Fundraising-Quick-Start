<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://soap.sforce.com/2006/04/metadata">
    <chart>
        <backgroundColor1>#FFFFFF</backgroundColor1>
        <backgroundColor2>#FFFFFF</backgroundColor2>
        <backgroundFadeDir>Diagonal</backgroundFadeDir>
        <chartSummaries>
            <axisBinding>y</axisBinding>
            <column>RowCount</column>
        </chartSummaries>
        <chartType>VerticalColumn</chartType>
        <enableHoverLabels>false</enableHoverLabels>
        <expandOthers>true</expandOthers>
        <groupingColumn>GiftTransaction$FQS_Stewardship_Status__c</groupingColumn>
        <location>CHART_TOP</location>
        <showAxisLabels>true</showAxisLabels>
        <showPercentage>false</showPercentage>
        <showTotal>false</showTotal>
        <showValues>true</showValues>
        <size>Medium</size>
        <summaryAxisRange>Auto</summaryAxisRange>
        <textColor>#000000</textColor>
        <textSize>12</textSize>
        <titleColor>#000000</titleColor>
        <titleSize>18</titleSize>
    </chart>
    <columns>
        <field>GiftTransaction$Name</field>
    </columns>
    <columns>
        <aggregateTypes>Sum</aggregateTypes>
        <field>GiftTransaction$CurrentAmount</field>
    </columns>
    <columns>
        <field>GiftTransaction$TransactionDate</field>
    </columns>
    <description>Stewardship pipeline health — matrix of Paid contribution GTs (last 6 months) grouped by FQS_Stewardship_Status__c x Category. Surfaces gifts stuck in To Be Sent past SLA. Live target for the 07:00 UTC stewardship batch queue.</description>
    <filter>
        <criteriaItems>
            <column>GiftTransaction$Status</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>Paid</value>
        </criteriaItems>
        <criteriaItems>
            <column>GiftTransaction$TransactionDate</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>greaterOrEqual</operator>
            <value>LAST_N_MONTHS:6</value>
        </criteriaItems>
    </filter>
    <format>Matrix</format>
    <groupingsAcross>
        <field>GiftTransaction$FQS_Gift_Transaction_Category__c</field>
        <sortOrder>Asc</sortOrder>
    </groupingsAcross>
    <groupingsDown>
        <field>GiftTransaction$FQS_Stewardship_Status__c</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <name>FQS Stewardship Pipeline</name>
    <params>
        <name>co</name>
        <value>1</value>
    </params>
    <reportType>fqs_Gift_Transactions_Deluxe__c</reportType>
    <scope>organization</scope>
    <showDetails>true</showDetails>
    <showGrandTotal>true</showGrandTotal>
    <showSubTotals>true</showSubTotals>
</Report>
