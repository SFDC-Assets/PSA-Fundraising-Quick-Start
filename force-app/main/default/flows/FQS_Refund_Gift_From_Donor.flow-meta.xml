        <description>Input: Id of the source Account (donor). Passed automatically by the Lightning quick action on the Account record page.</description>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
