    <recordLookups>
        <description>Pre-queries the donor&apos;s refundable Gift Transactions: Status=Paid with positive CurrentAmount. Fundraising Cloud only permits GiftRefund inserts against Paid GTs (Pending/Failed/Cancelled are rejected at the platform layer with FIELD_INTEGRITY_EXCEPTION). Returned as a collection so the pick screen can render a native flowruntime:datatable. Ordered by TransactionDate DESC so the most recent gift is at the top.</description>
        <name>Get_Donor_Refundable_GTs</name>
        <label>Get Donor Refundable GTs</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Decision_Any_Refundable</targetReference>
        </connector>
        <filterLogic>1 AND 2 AND 3</filterLogic>
        <filters>
            <field>DonorId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <filters>
            <field>CurrentAmount</field>
            <operator>GreaterThan</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Paid</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>GiftTransaction</object>
        <sortField>TransactionDate</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
