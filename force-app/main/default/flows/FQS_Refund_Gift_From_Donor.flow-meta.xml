                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>refundAmount</name>
            <dataType>Currency</dataType>
            <defaultValue>
                <elementReference>Get_GT.CurrentAmount</elementReference>
            </defaultValue>
            <fieldText>Refund Amount</fieldText>
            <fieldType>InputField</fieldType>
            <helpText>&lt;p&gt;Defaults to the full outstanding amount. Enter a smaller number for a partial refund.&lt;/p&gt;</helpText>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <scale>2</scale>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
            <validationRule>
                <errorMessage>Refund amount must be greater than zero and no more than {!Get_GT.CurrentAmount}.</errorMessage>
                <formulaExpression>AND({!refundAmount} &gt; 0, {!refundAmount} &lt;= {!Get_GT.CurrentAmount})</formulaExpression>
            </validationRule>
        </fields>
        <fields>
            <name>refundDate</name>
            <dataType>Date</dataType>
            <defaultValue>
                <elementReference>$Flow.CurrentDate</elementReference>
            </defaultValue>
            <fieldText>Refund Date</fieldText>
            <fieldType>InputField</fieldType>
            <helpText>&lt;p&gt;The date the refund settled or was recorded. Defaults to today.&lt;/p&gt;</helpText>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>refundReason</name>
            <choiceReferences>Choice_Reason_DonorRequest</choiceReferences>
            <choiceReferences>Choice_Reason_IncorrectAmount</choiceReferences>
            <choiceReferences>Choice_Reason_DuplicateGift</choiceReferences>
            <choiceReferences>Choice_Reason_MatchCorrection</choiceReferences>
            <choiceReferences>Choice_Reason_BouncedCheck</choiceReferences>
            <choiceReferences>Choice_Reason_TestTransaction</choiceReferences>
            <choiceReferences>Choice_Reason_Fraudulent</choiceReferences>
            <choiceReferences>Choice_Reason_Chargeback</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Reason</fieldText>
            <fieldType>DropdownBox</fieldType>
            <helpText>&lt;p&gt;Why this refund is happening.&lt;/p&gt;</helpText>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>refundNote</name>
            <fieldText>Note (optional)</fieldText>
            <fieldType>LargeTextArea</fieldType>
            <helpText>&lt;p&gt;Free-text audit note stored on the refund record&apos;s LastGatewayErrorMessage field.&lt;/p&gt;</helpText>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>false</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>FeeHeader</name>
            <fieldText>&lt;h3&gt;Fee reversal&lt;/h3&gt;&lt;p&gt;This gift carries gateway or processor fees. Confirm the fee amounts being reversed alongside the principal.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>frmHasFees</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <booleanValue>true</booleanValue>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <fields>
            <name>reverseProcessorFee</name>
            <dataType>Currency</dataType>
            <defaultValue>
                <elementReference>Get_GT.ProcessorTransactionFee</elementReference>
            </defaultValue>
            <fieldText>Reverse Processor Fee</fieldText>
            <fieldType>InputField</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>false</isRequired>
            <scale>2</scale>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>frmHasFees</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <booleanValue>true</booleanValue>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <fields>
            <name>reverseGatewayFee</name>
            <dataType>Currency</dataType>
            <defaultValue>
                <elementReference>Get_GT.GatewayTransactionFee</elementReference>
            </defaultValue>
            <fieldText>Reverse Gateway Fee</fieldText>
            <fieldType>InputField</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>false</isRequired>
            <scale>2</scale>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>frmHasFees</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <booleanValue>true</booleanValue>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <description>Fault path.</description>
        <name>Screen_Refund_Error</name>
        <label>Refund Failed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>ErrorMsg</name>
            <fieldText>&lt;h2&gt;Refund could not be created&lt;/h2&gt;&lt;p&gt;{!$Flow.FaultMessage}&lt;/p&gt;&lt;p&gt;Close this window and try again, or contact your administrator if the error persists.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <description>Confirmation with post-refund balances.</description>
        <name>Screen_Refund_Processed</name>
        <label>Refund Processed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>ProcessedMsg</name>
            <fieldText>&lt;h2&gt;Refund processed&lt;/h2&gt;&lt;p&gt;&lt;b&gt;{!frmRefundAmount}&lt;/b&gt; refunded from &lt;b&gt;{!Get_GT.Name}&lt;/b&gt; on {!refundDate}.&lt;/p&gt;&lt;h3&gt;New balances&lt;/h3&gt;&lt;ul&gt;&lt;li&gt;Outstanding: &lt;b&gt;{!Get_GT_After.CurrentAmount}&lt;/b&gt;&lt;/li&gt;&lt;li&gt;Total refunded: &lt;b&gt;{!Get_GT_After.RefundedAmount}&lt;/b&gt;&lt;/li&gt;&lt;li&gt;Gift status: &lt;b&gt;{!Get_GT_After.Status}&lt;/b&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;a href=&quot;/{!Create_GiftRefund}&quot;&gt;View the refund record&lt;/a&gt;.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Donor_Refundable_GTs</targetReference>
        </connector>
    </start>
