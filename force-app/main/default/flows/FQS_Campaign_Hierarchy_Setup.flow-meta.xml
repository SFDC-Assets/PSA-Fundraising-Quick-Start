        <fields>
            <name>DisplayText_ModelIntro</name>
            <fieldText>&lt;p&gt;&lt;strong style=&quot;font-size: 16px;&quot;&gt;Set up your campaign hierarchy&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;This setup creates a three-level Campaign hierarchy for your Fundraising Quick Start. Pick the model that matches how your team reports on giving, then choose which suggested campaigns to create on the next screens.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;strong style=&quot;font-size: 16px;&quot;&gt;The three-level shape:&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;strong style=&quot;font-size: 16px;&quot;&gt;Level 1 — Rollup:&lt;/strong&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt; the organizing anchor (year or program).&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;strong style=&quot;font-size: 16px;&quot;&gt;Level 2 — Strategy:&lt;/strong&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt; a coordinated set of asks — the level most staff watch while a campaign is running.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;strong style=&quot;font-size: 16px;&quot;&gt;Level 3 — Ask:&lt;/strong&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt; one concrete solicitation sent to one audience.&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>radioModel</name>
            <choiceReferences>choiceSeasonal</choiceReferences>
            <choiceReferences>choiceGivingPrograms</choiceReferences>
            <choiceReferences>choiceStrategy</choiceReferences>
            <dataType>String</dataType>
            <defaultSelectedChoiceReference>choiceSeasonal</defaultSelectedChoiceReference>
            <fieldText>How do you want to organize your campaigns?</fieldText>
            <fieldType>RadioButtons</fieldType>
            <helpText>Seasonal: year totals and YoY comparisons are one filter. Giving Programs: program lifetime is one filter. Strategy: donor-journey performance is the primary lens.</helpText>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>DisplayText_ModelOutline</name>
            <fieldText>&lt;p&gt;&lt;strong style=&quot;font-size: 14px;&quot;&gt;Seasonal / Yearly — sample shape&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;strong&gt;FY26 Fundraising&lt;/strong&gt; (rollup)&lt;ul&gt;&lt;li&gt;Spring Appeal FY26 (strategy) → Email · Direct Mail (asks)&lt;/li&gt;&lt;li&gt;Annual Celebration FY26 (strategy) → Save-the-Date · Invitation · Sponsorship Packet&lt;/li&gt;&lt;li&gt;Year-End Push FY26 (strategy) → Giving Tuesday Email · December Reminder SMS&lt;/li&gt;&lt;li&gt;Foundation Giving FY26 (strategy)&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;strong style=&quot;font-size: 14px;&quot;&gt;Giving Programs — sample shape&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;strong&gt;Major Gifts&lt;/strong&gt; (rollup, evergreen) → FY26 (strategy) → Portfolio Solicitations · Prospect Discovery Visits&lt;/li&gt;&lt;li&gt;&lt;strong&gt;Planned Giving · Online Giving · Events · Foundation Giving · Annual Giving&lt;/strong&gt; each get their own evergreen rollup + FY26 cohort + asks&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;strong style=&quot;font-size: 14px;&quot;&gt;Strategy — sample shape&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;strong&gt;FY26 Donor Strategy&lt;/strong&gt; (rollup) → Lapsed Reactivation · New Donor Acquisition · Retention &amp; Stewardship · Mid-Level Cultivation · Foundation Giving (strategies) → each with its own ask campaigns&lt;/li&gt;&lt;/ul&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
