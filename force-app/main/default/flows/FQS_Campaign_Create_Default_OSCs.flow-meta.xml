<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Fundraising Quick Start: manual-trigger path — when an admin flips FQS_Create_Default_Outreach_Sources__c from false to true on a Tactical-level campaign (Hierarchy Depth &gt;= 3), calls FQS_OutreachSourceCodeBuilder to auto-create one default OutreachSourceCode. Idempotent via External_Id__c so this can also be used to re-provision a deleted OSC. Flow leaves the checkbox true so it acts as a persistent audit flag; the hierarchy builder sets it true directly for the bulk-provisioning path.</description>
    <environments>Default</environments>
    <interviewLabel>FQS Campaign Create Default OSCs {!$Flow.CurrentDateTime}</interviewLabel>
    <label>FQS Campaign Create Default OSCs</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <assignments>
        <name>Assign_Campaign_Id_To_Collection</name>
        <label>Assign Campaign Id To Collection</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varCampaignIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Call_OSC_Builder</targetReference>
        </connector>
    </assignments>
    <actionCalls>
        <name>Call_OSC_Builder</name>
        <label>Call OSC Builder</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>FQS_OutreachSourceCodeBuilder</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>campaignIds</name>
            <value>
                <elementReference>varCampaignIds</elementReference>
            </value>
        </inputParameters>
        <nameSegment>FQS_OutreachSourceCodeBuilder</nameSegment>
        <offset>0</offset>
    </actionCalls>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Assign_Campaign_Id_To_Collection</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>FQS_Create_Default_Outreach_Sources__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>FQS_Hierarchy_Depth__c</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <numberValue>3.0</numberValue>
            </value>
        </filters>
        <object>Campaign</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>varCampaignIds</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
