<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Has_Existing_Member</name>
        <label>Has Existing Member?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <description>Determines whether the donor's Contact already has a CampaignMember row on this campaign. If yes, flip its status to Pledged/Gave; if no, create a new row so the donor still shows up on the campaign roster and the Account Launcher's Campaign picker.</description>
        <defaultConnector>
            <targetReference>Create_Member_Pledged_Gave</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No (Create)</defaultConnectorLabel>
        <rules>
            <name>Yes_Update</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Existing_Member</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Member_Pledged_Gave</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Non_Event_Campaign</name>
        <label>Is Non-Event Campaign?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <description>Event campaigns intentionally do not auto-flip status when a gift lands — a donor may decline the event but still give, and their CampaignMember should remain Declined (or absent). Only baseline ladders (Solicited → Pledged/Gave) auto-advance.</description>
        <defaultConnectorLabel>No (Event or Unknown)</defaultConnectorLabel>
        <rules>
            <name>Yes_Baseline</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Campaign.FQS_Campaign_Category__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Campaign.FQS_Campaign_Category__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Events</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Donor_Account</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Person_Account</name>
        <label>Is Person Account?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <description>CampaignMember requires a Contact — Person Accounts expose one via PersonContactId, but Org Accounts do not. Org donors are skipped here; if their gift needs campaign attribution, that lives on GiftTransaction.CampaignId already.</description>
        <defaultConnectorLabel>No (Org or Missing)</defaultConnectorLabel>
        <rules>
            <name>Yes_Person</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Donor_Account.PersonContactId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Existing_Member</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Fundraising Quick Start: when a GiftTransaction is inserted against a non-event campaign, flips the donor's CampaignMember to Pledged/Gave (or creates one if missing). Event campaigns are excluded — attendance is captured manually and a gift on an event campaign does not imply the member attended. Org donors are skipped because CampaignMember requires a Contact.</description>
    <environments>Default</environments>
    <interviewLabel>FQS Campaign Member Status On Gift {!$Flow.CurrentDateTime}</interviewLabel>
    <label>FQS Campaign Member Status On Gift</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Member_Pledged_Gave</name>
        <label>Create Member (Pledged/Gave)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <description>Creates a new CampaignMember at status Pledged/Gave for donors who gave without a prior solicitation record — e.g., walk-in gifts, unsolicited donations, or gifts that landed before the outreach process created the member.</description>
        <inputAssignments>
            <field>CampaignId</field>
            <value>
                <elementReference>$Record.CampaignId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ContactId</field>
            <value>
                <elementReference>Get_Donor_Account.PersonContactId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Pledged/Gave</stringValue>
            </value>
        </inputAssignments>
        <object>CampaignMember</object>
    </recordCreates>
    <recordLookups>
        <name>Get_Campaign</name>
        <label>Get Campaign</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <description>Fetches the parent Campaign so its FQS_Campaign_Category__c can gate whether status auto-advances. Reading it here keeps the decision cleanly on the Campaign record rather than duplicating category logic on GiftTransaction.</description>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Is_Non_Event_Campaign</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.CampaignId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Campaign</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>FQS_Campaign_Category__c</queriedFields>
        <storeOutputAutomatically>false</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Donor_Account</name>
        <label>Get Donor Account</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <description>Retrieves the donor Account to determine whether it is a Person Account (has PersonContactId) and to hand the Contact Id to downstream CampaignMember steps. Org donors fall through the Person Account decision.</description>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Is_Person_Account</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.DonorId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>PersonContactId</queriedFields>
        <storeOutputAutomatically>false</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Existing_Member</name>
        <label>Get Existing Member</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <description>Looks up a CampaignMember for this Contact/Campaign pair. CampaignMember has a (CampaignId, ContactId) unique constraint, so at most one row can exist — safe to fetch first-only.</description>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Has_Existing_Member</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>CampaignId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.CampaignId</elementReference>
            </value>
        </filters>
        <filters>
            <field>ContactId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Donor_Account.PersonContactId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>CampaignMember</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Status</queriedFields>
        <storeOutputAutomatically>false</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Member_Pledged_Gave</name>
        <label>Update Member to Pledged/Gave</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <description>Flips an existing CampaignMember to Pledged/Gave when the donor already had a Solicited (or other) row and has now given. Unconditional overwrite is deliberate — a gift is the strongest signal on this ladder and should not be shadowed by a stale Solicited/Responded value.</description>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Existing_Member.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Pledged/Gave</stringValue>
            </value>
        </inputAssignments>
        <object>CampaignMember</object>
    </recordUpdates>
    <runInMode>DefaultMode</runInMode>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Campaign</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>CampaignId</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>DonorId</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>GiftTransaction</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
