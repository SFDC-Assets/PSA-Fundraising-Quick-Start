<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Fundraising Quick Start: when FQS_Create_First_Outreach_Source_Code__c flips to true on a Tactical-level Campaign (FQS_Hierarchy_Depth__c &gt;= 3) — either by admin action or by FQS_CampaignHierarchyBuilder — creates a placeholder OutreachSourceCode named "Create First OSC" with MessageChannel/Platform pre-seeded from FQS_Campaign_Category__c and SourceCode left blank for the Generate Source Code quick action to populate. Idempotent via External_Id__c = 'FQS-OSC-{CampaignId15}-DEFAULT' — the flow Gets by External_Id__c first and short-circuits if a placeholder already exists.</description>
    <environments>Default</environments>
    <interviewLabel>FQS Campaign Create First OSC {!$Flow.CurrentDateTime}</interviewLabel>
    <label>FQS Campaign Create First OSC</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <formulas>
        <name>formulaExternalId</name>
        <dataType>String</dataType>
        <expression>&quot;FQS-OSC-&quot; + LEFT({!$Record.Id}, 15) + &quot;-DEFAULT&quot;</expression>
    </formulas>
    <assignments>
        <name>Assign_Direct_Mail_Defaults</name>
        <label>Assign Direct Mail Defaults</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varMessageChannel</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Direct Mail</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varPlatform</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>direct_mail_house</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Assign_Status_And_Description</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Email_Defaults</name>
        <label>Assign Email Defaults</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varMessageChannel</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Email</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varPlatform</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>other_email</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Assign_Status_And_Description</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Physical_Defaults</name>
        <label>Assign Physical Defaults</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varMessageChannel</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Physical</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Assign_Status_And_Description</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Status_And_Description</name>
        <label>Assign Status And Description</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varCategoryLabel</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.FQS_Campaign_Category__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Decide_Status</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Category_Label_Fallback</name>
        <label>Assign Category Label Fallback</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varCategoryLabel</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Tactical</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Assign_Description</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Description</name>
        <label>Assign Description</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varDescription</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Placeholder Outreach Source Code auto-created for </stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varDescription</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>varCategoryLabel</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varDescription</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue> campaign. Set Source Code via the Generate Source Code action, then rename.</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Create_Placeholder_OSC</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Status_Active</name>
        <label>Assign Status Active</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varStatus</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Active</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Decide_Category_Label</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Status_Inactive</name>
        <label>Assign Status Inactive</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varStatus</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Inactive</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Decide_Category_Label</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Decide_Placeholder_Exists</name>
        <label>Decide Placeholder Exists</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Decide_Category_Channel</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Found</defaultConnectorLabel>
        <rules>
            <name>Already_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Existing_Placeholder.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <label>Already Exists</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decide_Category_Channel</name>
        <label>Decide Category Channel</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Assign_Email_Defaults</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Email (Default)</defaultConnectorLabel>
        <rules>
            <name>Direct_Mail_Categories</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.FQS_Campaign_Category__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Annual Giving</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.FQS_Campaign_Category__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Planned Giving</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.FQS_Campaign_Category__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Grants</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Direct_Mail_Defaults</targetReference>
            </connector>
            <label>Direct Mail Categories</label>
        </rules>
        <rules>
            <name>Physical_Category</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.FQS_Campaign_Category__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Major Gifts</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Physical_Defaults</targetReference>
            </connector>
            <label>Physical Category</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decide_Status</name>
        <label>Decide Status</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Assign_Status_Inactive</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Inactive</defaultConnectorLabel>
        <rules>
            <name>Campaign_Is_Active</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.IsActive</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Status_Active</targetReference>
            </connector>
            <label>Campaign Is Active</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decide_Category_Label</name>
        <label>Decide Category Label</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Assign_Category_Label_Fallback</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Blank</defaultConnectorLabel>
        <rules>
            <name>Category_Populated</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.FQS_Campaign_Category__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Description</targetReference>
            </connector>
            <label>Category Populated</label>
        </rules>
    </decisions>
    <recordLookups>
        <name>Get_Existing_Placeholder</name>
        <label>Get Existing Placeholder</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Decide_Placeholder_Exists</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>External_Id__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>formulaExternalId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>OutreachSourceCode</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordCreates>
        <name>Create_Placeholder_OSC</name>
        <label>Create Placeholder OSC</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>CampaignId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>varDescription</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>External_Id__c</field>
            <value>
                <elementReference>formulaExternalId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>FQS_Platform__c</field>
            <value>
                <elementReference>varPlatform</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>MessageChannel</field>
            <value>
                <elementReference>varMessageChannel</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Name</field>
            <value>
                <stringValue>Create First OSC</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <elementReference>varStatus</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>UsageType</field>
            <value>
                <stringValue>Fundraising</stringValue>
            </value>
        </inputAssignments>
        <object>OutreachSourceCode</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Existing_Placeholder</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>FQS_Create_First_Outreach_Source_Code__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>FQS_Hierarchy_Depth__c</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <numberValue>3.0</numberValue>
            </value>
        </filters>
        <object>Campaign</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>varCategoryLabel</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varDescription</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varMessageChannel</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varPlatform</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varStatus</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
