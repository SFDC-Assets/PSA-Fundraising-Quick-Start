<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Seed the candidate-Id accumulator with the ACR-reach Account Ids produced by Transform_ACR_Account_Ids.</description>
        <name>Assign_Seed_SoftCredit_Ids</name>
        <label>Seed SoftCredit Ids (ACR reach)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>col_SoftCreditAccountIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Transform_ACR_Account_Ids</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Related_CCRs</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Append the CCR-reach Account Ids produced by Transform_CCR_Account_Ids to the accumulator.</description>
        <name>Assign_Append_CCR_Account_Ids</name>
        <label>Append SoftCredit Ids (CCR reach)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>col_SoftCreditAccountIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Transform_CCR_Account_Ids</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_SoftCredit_Accounts</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Copy the deduped Account collection from Get_SoftCredit_Accounts into the output variable exposed to the parent flow.</description>
        <name>Assign_Output_SoftCreditAccounts</name>
        <label>Expose SoftCredit Accounts to Parent</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>outCollection_SoftCreditAccounts</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_SoftCredit_Accounts</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <description>Reach subflow: given an Account and its Contact Ids, resolve unique candidate soft-credit Accounts via active ACRs (Account-Contact Relations) and active CCRs (Contact-Contact Relations reachable from those Contacts). Called only when the user opts into soft credits on the parent flow&apos;s Gift Details screen. The donor&apos;s own Account is filtered out inline on the ACR query and on the CCR Contact resolution. Returns the deduped Account collection as outCollection_SoftCreditAccounts.</description>
    <environments>Default</environments>
    <interviewLabel>FQS Gift Entry — Soft Credit Reach {!$Flow.CurrentDateTime}</interviewLabel>
    <label>FQS Gift Entry — Soft Credit Reach</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Resolves CCR-related Contact Ids to their AccountIds. Self-Account is excluded inline so CCR-reach candidates do not include the donor themselves.</description>
        <name>Get_Contacts_FromCCRs</name>
        <label>Get Contacts (from CCRs)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Transform_CCR_Account_Ids</targetReference>
        </connector>
        <filterLogic>1 AND 2</filterLogic>
        <filters>
            <field>Id</field>
            <operator>In</operator>
            <value>
                <elementReference>Transform_CCR_Related_Contact_Ids</elementReference>
            </value>
        </filters>
        <filters>
            <field>AccountId</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Contact</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Active ACRs whose ContactId is on this Account. AccountId of each is a soft-credit candidate. Self-Account is excluded inline.</description>
        <name>Get_Related_ACRs</name>
        <label>Get Related ACRs</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Transform_ACR_Account_Ids</targetReference>
        </connector>
        <filterLogic>1 AND 2 AND 3</filterLogic>
        <filters>
            <field>ContactId</field>
            <operator>In</operator>
            <value>
                <elementReference>col_AccountContactIds</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>AccountId</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>AccountContactRelation</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Active CCRs whose ContactId is on this Account. RelatedContactId is separately resolved to its AccountId via Get_Contacts_FromCCRs.</description>
        <name>Get_Related_CCRs</name>
        <label>Get Related CCRs</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Transform_CCR_Related_Contact_Ids</targetReference>
        </connector>
        <filterLogic>1 AND 2</filterLogic>
        <filters>
            <field>ContactId</field>
            <operator>In</operator>
            <value>
                <elementReference>col_AccountContactIds</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>ContactContactRelation</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Loads the candidate soft-credit Accounts. The Id filter accepts duplicates in the input collection — SOQL returns each Account once. This output is exposed to the parent as outCollection_SoftCreditAccounts.</description>
        <name>Get_SoftCredit_Accounts</name>
        <label>Get Soft-Credit Accounts</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Assign_Output_SoftCreditAccounts</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>In</operator>
            <value>
                <elementReference>col_SoftCreditAccountIds</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Account</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Related_ACRs</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <transforms>
        <description>Map each ACR row to its AccountId — the candidate soft-credit Account.</description>
        <name>Transform_ACR_Account_Ids</name>
        <label>Transform ACR Account Ids</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Assign_Seed_SoftCredit_Ids</targetReference>
        </connector>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <scale>0</scale>
        <storeOutputAutomatically>true</storeOutputAutomatically>
        <transformValues>
            <transformValueActions>
                <transformType>Map</transformType>
                <value>
                    <elementReference>Get_Related_ACRs[$EachItem].AccountId</elementReference>
                </value>
            </transformValueActions>
        </transformValues>
    </transforms>
    <transforms>
        <description>Map each CCR row to its RelatedContactId — the far-side Contact to resolve to an Account.</description>
        <name>Transform_CCR_Related_Contact_Ids</name>
        <label>Transform CCR Related Contact Ids</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Contacts_FromCCRs</targetReference>
        </connector>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <scale>0</scale>
        <storeOutputAutomatically>true</storeOutputAutomatically>
        <transformValues>
            <transformValueActions>
                <transformType>Map</transformType>
                <value>
                    <elementReference>Get_Related_CCRs[$EachItem].RelatedContactId</elementReference>
                </value>
            </transformValueActions>
        </transformValues>
    </transforms>
    <transforms>
        <description>Map each resolved Contact to its AccountId — the CCR-reach candidate soft-credit Account.</description>
        <name>Transform_CCR_Account_Ids</name>
        <label>Transform CCR Account Ids</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Assign_Append_CCR_Account_Ids</targetReference>
        </connector>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <scale>0</scale>
        <storeOutputAutomatically>true</storeOutputAutomatically>
        <transformValues>
            <transformValueActions>
                <transformType>Map</transformType>
                <value>
                    <elementReference>Get_Contacts_FromCCRs[$EachItem].AccountId</elementReference>
                </value>
            </transformValueActions>
        </transformValues>
    </transforms>
    <variables>
        <description>Input: Contact Ids on the donor&apos;s Account (household). Parent flow computes these from Get_Contacts_ForAcct and passes them in verbatim.</description>
        <name>col_AccountContactIds</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Accumulator for candidate soft-credit Account Ids across ACR and CCR reach. Populated in two Add-collection assignments; passed as-is to Get_SoftCredit_Accounts.</description>
        <name>col_SoftCreditAccountIds</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Output: deduped Account collection of soft-credit candidates. Parent flow binds this to its datatable input.</description>
        <name>outCollection_SoftCreditAccounts</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <objectType>Account</objectType>
    </variables>
    <variables>
        <description>Input: Id of the donor Account. Used to filter out the donor&apos;s own Account inline on the ACR and Contact queries.</description>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
