        <nameSegment>emailSimple</nameSegment>
        <offset>0</offset>
    </actionCalls>
    <actionCalls>
        <name>Setup_Fundraising_DPE_Definitions</name>
        <label>Setup Fundraising DPE Definitions</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>manageFundraisingDefinitions</actionName>
        <actionType>manageFundraisingDefinitions</actionType>
        <connector>
            <targetReference>Batch_Job_Loop</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Send_Failure_Email</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>currentCalendarYear</name>
            <value>
                <elementReference>CURRENTCALENDARYEAR</elementReference>
                <inputConfiguratorMode>Resource</inputConfiguratorMode>
            </value>
        </inputParameters>
        <inputParameters>
            <name>lastCalendarYear</name>
            <value>
                <elementReference>LASTCALENDARYEAR</elementReference>
                <inputConfiguratorMode>Resource</inputConfiguratorMode>
            </value>
        </inputParameters>
        <inputParameters>
            <name>lastTwoCalendarYears</name>
            <value>
                <elementReference>LASTTWOCALENDARYEAR</elementReference>
                <inputConfiguratorMode>Resource</inputConfiguratorMode>
            </value>
        </inputParameters>
        <inputParameters>
            <name>runDonorGiftSummary</name>
            <value>
                <booleanValue>true</booleanValue>
                <inputConfiguratorMode>Resource</inputConfiguratorMode>
            </value>
        </inputParameters>
        <inputParameters>
            <name>runOutreachSummary</name>
            <value>
                <booleanValue>true</booleanValue>
                <inputConfiguratorMode>Resource</inputConfiguratorMode>
            </value>
        </inputParameters>
        <inputParameters>
            <name>runGiftDesignation</name>
            <value>
                <booleanValue>true</booleanValue>
                <inputConfiguratorMode>Resource</inputConfiguratorMode>
            </value>
        </inputParameters>
        <nameSegment>manageFundraisingDefinitions</nameSegment>
        <offset>0</offset>
        <outputParameters>
            <assignToReference>varBatchJobIds</assignToReference>
            <name>batchJobIdsList</name>
        </outputParameters>
    </actionCalls>
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Scheduled flow that runs the Manage Fundraising Definitions invocable action daily to refresh Fundraising rollup summaries (Donor Gift Summary, Outreach Summary, Gift Designation). Waits for each batch job to complete via the Batch Job Status Changed platform event (filtered to the current job) with a 24-hour timeout guard, and emails the org&apos;s Default Workflow User on fault.</description>
    <environments>Default</environments>
    <formulas>
        <name>CURRENTCALENDARYEAR</name>
        <dataType>Date</dataType>
        <expression>DATE(YEAR({!$Flow.CurrentDate}),1,1)</expression>
    </formulas>
    <formulas>
        <name>LASTCALENDARYEAR</name>
        <dataType>Date</dataType>
        <expression>DATE(YEAR({!$Flow.CurrentDate})-1,1,1)</expression>
    </formulas>
    <formulas>
        <name>LASTTWOCALENDARYEAR</name>
        <dataType>Date</dataType>
        <expression>DATE(YEAR({!$Flow.CurrentDate})-2,1,1)</expression>
    </formulas>
    <interviewLabel>FQS Automatic Rollup Updates {!$Flow.CurrentDateTime}</interviewLabel>
    <label>FQS Automatic Rollup Updates</label>
    <loops>
        <name>Batch_Job_Loop</name>
        <label>Batch Job Loop</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>varBatchJobIds</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Wait_For_Batch_Job_To_Complete</targetReference>
        </nextValueConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <runInMode>DefaultMode</runInMode>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Setup_Fundraising_DPE_Definitions</targetReference>
        </connector>
        <schedule>
            <dayOfMonthToRun>0</dayOfMonthToRun>
            <frequency>Daily</frequency>
            <frequencyNumber>0</frequencyNumber>
            <startDate>2026-01-01</startDate>
            <startTime>02:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>varBatchJobIds</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <waits>
        <name>Wait_For_Batch_Job_To_Complete</name>
        <label>Wait For Batch Job To Complete</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Batch_Job_Loop</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Path</defaultConnectorLabel>
        <waitEvents>
            <name>BatchJobComplete</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Batch_Job_Loop</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue></stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Batch_Job_Loop</targetReference>
            </connector>
            <eventType>BatchJobStatusChangedEvent</eventType>
            <inputParameters>
                <name>BatchJob</name>
                <value>
                    <elementReference>Batch_Job_Loop</elementReference>
                </value>
            </inputParameters>
            <label>Batch Job Complete</label>
        </waitEvents>
        <waitEvents>
            <name>Time_Out_After_A_Day</name>
            <conditionLogic>and</conditionLogic>
            <connector>
                <targetReference>Batch_Job_Loop</targetReference>
            </connector>
            <eventType>AlarmEvent</eventType>
            <inputParameters>
                <name>AlarmTime</name>
                <value>
                    <elementReference>$Flow.InterviewStartTime</elementReference>
                </value>
            </inputParameters>
            <inputParameters>
                <name>TimeOffset</name>
                <value>
                    <numberValue>24.0</numberValue>
                </value>
            </inputParameters>
            <inputParameters>
                <name>TimeOffsetUnit</name>
                <value>
                    <stringValue>Hours</stringValue>
                </value>
            </inputParameters>
            <label>Time Out After A Day</label>
        </waitEvents>
    </waits>
</Flow>
