<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <choices>
        <name>choiceDonorGrouping</name>
        <choiceText>Donor Grouping thresholds &amp; acknowledgement routing</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>DONOR_GROUPING</stringValue>
        </value>
    </choices>
    <choices>
        <name>choiceSuggestDesignations</name>
        <choiceText>Seed the Gift Designation catalog</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>SUGGEST_DESIGNATIONS</stringValue>
        </value>
    </choices>
    <decisions>
        <name>Decide_Which_Setup_Step</name>
        <label>Route to picked setup step</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Subflow_Donor_Grouping</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Donor Grouping (default)</defaultConnectorLabel>
        <rules>
            <name>Route_Suggest_Designations</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>pkSetupStep</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>choiceSuggestDesignations</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Subflow_Suggest_Designations</targetReference>
            </connector>
            <label>Suggest Designations</label>
        </rules>
    </decisions>
    <description>Top-level FQS setup chooser. Presents the admin with a list of setup steps and dispatches each pick to a dedicated subflow. Currently offers Donor Grouping (thresholds + acknowledgement routing) and Suggest Designations (seed starter Gift Designation catalog). Referenced by the FQS Setup Configuration flexipage and the Fundraising Quick Start utility bar.</description>
    <interviewLabel>FQS Setup Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>FQS Setup Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <runInMode>DefaultMode</runInMode>
    <screens>
        <name>Screen_Pick_Setup_Step</name>
        <label>FQS Setup</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Decide_Which_Setup_Step</targetReference>
        </connector>
        <fields>
            <name>DisplayText_Setup_Intro</name>
            <fieldText>&lt;p&gt;&lt;strong style=&quot;font-size: 16px;&quot;&gt;Welcome to Fundraising Quick Start setup.&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;Pick a setup step below. Each step is independent, so you can run them in any order and return to this flow at any time to run another step.&lt;/span&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>pkSetupStep</name>
            <choiceReferences>choiceDonorGrouping</choiceReferences>
            <choiceReferences>choiceSuggestDesignations</choiceReferences>
            <dataType>String</dataType>
            <defaultSelectedChoiceReference>choiceDonorGrouping</defaultSelectedChoiceReference>
            <fieldText>Which setup step do you want to run?</fieldText>
            <fieldType>RadioButtons</fieldType>
            <helpText>Donor Grouping thresholds and acknowledgement routing sets the dollar bands for Entry, Mid, and Major donors and decides how each grouping&apos;s acknowledgements are routed. Seed the Gift Designation catalog creates a starter set of Gift Designations if your org has none.</helpText>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Screen_Pick_Setup_Step</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <subflows>
        <name>Subflow_Donor_Grouping</name>
        <label>Run Donor Grouping Setup</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>FQS_Setup_Donor_Grouping</flowName>
    </subflows>
    <subflows>
        <name>Subflow_Suggest_Designations</name>
        <label>Run Suggest Designations</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>FQS_Suggest_Designations</flowName>
    </subflows>
</Flow>
