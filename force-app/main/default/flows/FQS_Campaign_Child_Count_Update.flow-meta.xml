<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Calculate_New_Parent_Count</name>
        <label>Calculate New Parent Count</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <description>Resets varNewParentCount to 0, then sets it to the count of direct children found under the new parent. Establishes the value that will be written back to the new parent's rollup field.</description>
        <assignmentItems>
            <assignToReference>varNewParentCount</assignToReference>
            <operator>Assign</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varNewParentCount</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>varNewParentChildren</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Increment_New_Count</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Calculate_Old_Parent_Count</name>
        <label>Calculate Old Parent Count</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <description>Resets varOldParentCount to 0, then sets it to the count of remaining direct children under the previous parent. Used when a campaign is reparented so the former parent's rollup is decremented.</description>
        <assignmentItems>
            <assignToReference>varOldParentCount</assignToReference>
            <operator>Assign</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varOldParentCount</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>varOldParentChildren</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Old_Parent</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Increment_New_Count</name>
        <label>Increment New Count</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <description>Reasserts varNewParentCount from the sibling collection immediately before the update to the new parent, guarding against any stale value if this branch is entered on a later iteration.</description>
        <assignmentItems>
            <assignToReference>varNewParentCount</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>varNewParentChildren</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_New_Parent</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Has_New_Parent</name>
        <label>Has New Parent?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <description>Checks whether the current record has a ParentId. If yes, recount children on the new parent; if no (root campaign or parent cleared), skip ahead to the old-parent branch.</description>
        <defaultConnector>
            <targetReference>Has_Old_Parent</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Has_New_Parent</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.ParentId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_New_Parent_Children</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Has_Old_Parent</name>
        <label>Has Old Parent (Changed)?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <description>Checks whether the prior ParentId was populated and differs from the current ParentId. Only true on reparenting — ensures the previous parent's child count is decremented; no-op for pure inserts or unrelated updates.</description>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Has_Old_Parent</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.ParentId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.ParentId</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.ParentId</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Old_Parent_Children</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Fundraising Quick Start: keeps FQS_Child_Campaign_Count__c accurate on parent campaigns. Fires when a campaign is created or its ParentId changes; recounts direct children on the new parent and (if different) the old parent.</description>
    <environments>Default</environments>
    <interviewLabel>FQS Campaign Child Count Update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>FQS Campaign Child Count Update</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_New_Parent_Children</name>
        <label>Get New Parent Children</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <description>Retrieves all direct children of the new parent (ParentId equals $Record.ParentId). Because this runs after save, the current record is already included in the results.</description>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Calculate_New_Parent_Count</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ParentId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ParentId</elementReference>
            </value>
        </filters>
        <object>Campaign</object>
        <outputReference>varNewParentChildren</outputReference>
        <queriedFields>Id</queriedFields>
        <sortField>Id</sortField>
        <sortOrder>Asc</sortOrder>
    </recordLookups>
    <recordLookups>
        <name>Get_Old_Parent_Children</name>
        <label>Get Old Parent Children</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <description>Retrieves the direct children still remaining under the prior parent ($Record__Prior.ParentId) after the current record has been reparented, so its child count can be decremented accurately.</description>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Calculate_Old_Parent_Count</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ParentId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record__Prior.ParentId</elementReference>
            </value>
        </filters>
        <object>Campaign</object>
        <outputReference>varOldParentChildren</outputReference>
        <queriedFields>Id</queriedFields>
        <sortField>Id</sortField>
        <sortOrder>Asc</sortOrder>
    </recordLookups>
    <recordUpdates>
        <name>Update_New_Parent</name>
        <label>Update New Parent</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <description>Writes the recalculated child count to FQS_Child_Campaign_Count__c on the new parent campaign. Runs whenever this record has a parent — covers inserts, reparenting, and (edge-case) same-parent updates that re-trigger the flow.</description>
        <connector>
            <targetReference>Has_Old_Parent</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ParentId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>FQS_Child_Campaign_Count__c</field>
            <value>
                <elementReference>varNewParentCount</elementReference>
            </value>
        </inputAssignments>
        <object>Campaign</object>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Old_Parent</name>
        <label>Update Old Parent</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <description>Writes the recalculated child count to FQS_Child_Campaign_Count__c on the previous parent campaign, decrementing its rollup after this record has been reparented away.</description>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record__Prior.ParentId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>FQS_Child_Campaign_Count__c</field>
            <value>
                <elementReference>varOldParentCount</elementReference>
            </value>
        </inputAssignments>
        <object>Campaign</object>
    </recordUpdates>
    <runInMode>DefaultMode</runInMode>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Has_New_Parent</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ParentId</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Campaign</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>varNewParentChildren</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Campaign</objectType>
    </variables>
    <variables>
        <name>varNewParentCount</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
    <variables>
        <name>varOldParentChildren</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Campaign</objectType>
    </variables>
    <variables>
        <name>varOldParentCount</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
</Flow>
